---
// src/components/SectionTitle.astro
const { id, title, accent = "bg-white dark:bg-gray-950" } = Astro.props;
---
<!-- SectionTitle -->
<section id={id} class={`py-16 md:py-24 scroll-mt-20 ${accent}`}>
    <div class="max-w-6xl mx-auto px-6">
        <div class="max-w-3xl mb-10 md:mb-12">
            <h2 class="mb-4 text-2xl font-bold tracking-tight text-gray-900 md:text-3xl dark:text-white">{title}</h2>
            <slot />
        </div>
        <slot name="content" />
    </div>
</section>
