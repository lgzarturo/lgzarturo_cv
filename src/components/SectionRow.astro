---
// src/components/SectionRow.astro
const { id, title } = Astro.props;
---
<!-- SectionRow -->
<section id={id} class="py-16 md:py-24 scroll-mt-20 bg-gray-900 text-white dark:bg-black">
    <div class="max-w-4xl mx-auto px-6 text-center">
        <h2 class="mb-4 text-2xl font-bold tracking-tight md:text-3xl">{title}</h2>
        <slot />
    </div>
</section>
