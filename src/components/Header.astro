---
// src/components/Header.astro
const { title } = Astro.props;
const pathname = Astro.url.pathname;
const isCurrent = (href) => !href.includes("#") && (pathname === href || pathname.startsWith(href + "/"));
const links = [
  { href: "/#about", label: "Sobre Mí" },
  { href: "/#projects", label: "Laboratorio" },
  { href: "/#experience", label: "Experiencia" },
  { href: "/recursos", label: "Recursos" },
  { href: "/casos-de-estudio", label: "Casos" },
];
---
<!-- Header -->
<header class="fixed top-0 z-50 w-full border-b border-gray-200 bg-white/85 backdrop-blur-md dark:border-gray-800 dark:bg-gray-950/85">
    <nav class="max-w-6xl px-6 py-3 mx-auto" aria-label="Navegación principal">
        <div class="flex items-center justify-between gap-4">
            <a href="/" class="flex items-center gap-2 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
                <span class="flex items-center justify-center w-8 h-8 rounded-lg bg-blue-600">
                    <span class="text-sm font-bold text-white">ALG</span>
                </span>
                <span class="text-lg font-bold text-gray-900 dark:text-white">{title}</span>
            </a>
            <ul class="items-center hidden gap-7 md:flex">
                {links.map((link) => (
                    <li>
                        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined} class="text-sm font-medium text-gray-600 transition-colors duration-200 hover:text-blue-600 aria-[current=page]:text-blue-600 aria-[current=page]:font-semibold dark:text-gray-300 dark:hover:text-blue-400 dark:aria-[current=page]:text-blue-400 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 rounded">
                            {link.label}
                        </a>
                    </li>
                ))}
                <li>
                    <a href="/#contact" class="px-4 py-2 text-sm font-semibold text-white transition-colors duration-200 bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2">
                        Contacto
                    </a>
                </li>
                <li>
                    <button type="button" aria-pressed="false" class="px-3 py-2 text-sm font-medium text-gray-600 transition-colors bg-gray-100 rounded-lg dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 theme-toggle">
                        <span class="theme-toggle-text" data-dark="☀️ Modo claro" data-light="🌙 Modo oscuro">🌙 Modo oscuro</span>
                    </button>
                </li>
            </ul>
            <div class="flex items-center gap-2 md:hidden">
                <button type="button" aria-label="Modo oscuro" aria-pressed="false" class="flex items-center justify-center w-10 h-10 text-gray-600 transition-colors bg-gray-100 rounded-lg dark:bg-gray-800 dark:text-gray-300 hover:bg-gray-200 dark:hover:bg-gray-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 theme-toggle">
                    <span class="theme-toggle-text text-base" aria-hidden="true" data-dark="☀️" data-light="🌙">🌙</span>
                </button>
                <button id="mobile-menu-button" type="button" aria-label="Abrir menú" aria-expanded="false" aria-controls="mobile-menu" class="flex items-center justify-center w-10 h-10 text-gray-700 rounded-lg dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 focus:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>
        <div id="mobile-menu" class="hidden pt-2 pb-4 md:hidden">
            <ul class="flex flex-col gap-1">
                {links.map((link) => (
                    <li>
                        <a href={link.href} aria-current={isCurrent(link.href) ? "page" : undefined} class="block px-3 py-2.5 font-medium text-gray-700 rounded-lg dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-800 aria-[current=page]:bg-blue-50 aria-[current=page]:text-blue-700 dark:aria-[current=page]:bg-gray-800 dark:aria-[current=page]:text-blue-400">
                            {link.label}
                        </a>
                    </li>
                ))}
                <li>
                    <a href="/#contact" class="block px-3 py-2.5 font-semibold text-center text-white bg-blue-600 rounded-lg hover:bg-blue-700">
                        Contacto
                    </a>
                </li>
            </ul>
        </div>
    </nav>
<script is:inline>
    const menuBtn = document.getElementById('mobile-menu-button');
    const mobileMenu = document.getElementById('mobile-menu');
    function setMenu(open) {
        mobileMenu.classList.toggle('hidden', !open);
        menuBtn.setAttribute('aria-expanded', String(open));
        menuBtn.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
    }
    menuBtn?.addEventListener('click', () => setMenu(mobileMenu.classList.contains('hidden')));
    mobileMenu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
            setMenu(false);
            menuBtn.focus();
        }
    });
</script>
</header>
