---
// src/pages/casos-de-estudio/index.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';

const cases = [
    {
        href: '/casos-de-estudio/mailmind/',
        badge: 'Producto indie',
        badgeClass: 'bg-rose-100 text-rose-800 border-rose-200 dark:bg-rose-900/40 dark:text-rose-300 dark:border-rose-800',
        title: 'MailMind: convertir la señal del correo en trabajo ejecutable',
        problema: 'El trabajo nace en varias bandejas IMAP y se pierde entre notas sueltas y tableros a medias; la tentación es otro Gmail o un CRM hinchado.',
        rol: 'Fundador y product engineer (producto indie propio).',
        stack: 'Python · FastAPI · HTMX · IMAP IDLE · PostgreSQL · Redis · Docker (VPS)',
        resultado: 'Pre-release en producción (v0.15.2) con planes Free ($0: 1 cuenta IMAP, 1 proyecto, notas cifradas) y Pro (hasta 5 cuentas, 500 reglas y proyectos, Telegram y write-back a IMAP/Jira/Sentry sin crear tickets; desde 6 USD/mes los primeros 3 meses).',
        tags: ['Python', 'FastAPI', 'IMAP IDLE', 'Free + Pro'],
    },
    {
        href: '/casos-de-estudio/codeconductor/',
        badge: 'Open source / IA',
        badgeClass: 'bg-violet-100 text-violet-800 border-violet-200 dark:bg-violet-900/40 dark:text-violet-300 dark:border-violet-800',
        title: 'CodeConductor: de prompts sueltos a un sistema de ingeniería orquestado',
        problema: 'El prompting ad-hoc con IA produce sesiones brillantes e irreproducibles: sin contratos, sin roles ni portabilidad entre IDEs.',
        rol: 'Creador y mantenedor open source (product engineering).',
        stack: 'TypeScript · npm cc-codeconductor · Multi-agent',
        resultado: 'Framework MIT en npm 1.7.1 (31 versiones desde mayo de 2026): 15 Conductor Agents y 21+ slash commands para 7 targets. 249 descargas semanales y 1,337 en 30 días (npm, 16 oct 2026).',
        tags: ['TypeScript', 'Multi-agent', 'MIT', 'npm'],
    },
    {
        href: '/casos-de-estudio/ats-startalent/',
        badge: 'Rediseño SaaS',
        badgeClass: 'bg-green-100 text-green-800 border-green-200 dark:bg-green-900/40 dark:text-green-300 dark:border-green-800',
        title: 'Rediseño del ATS StarTalent a SaaS hotelero',
        problema: 'ATS interno monousuario, sin multitenancy ni separación de datos, bloqueaba la venta como producto SaaS hotelero.',
        rol: 'Arquitectura, UI e infraestructura del rediseño a producto.',
        stack: 'Grails · Groovy · Multi-tenant · VPS',
        resultado: '+60% en clientes corporativos en menos de dos años (claim del sitio).',
        tags: ['Grails', 'Groovy', 'Multi-tenant'],
    },
    {
        href: '/casos-de-estudio/programa-de-lealtad/',
        badge: 'Microservicios',
        badgeClass: 'bg-blue-100 text-blue-800 border-blue-200 dark:bg-blue-900/40 dark:text-blue-300 dark:border-blue-800',
        title: 'Migración del Programa de Lealtad a microservicios',
        problema: 'Monolito de lealtad difícil de evolucionar, con riesgo de downtime al crecer la base de usuarios.',
        rol: 'Liderazgo técnico de la migración (patrón Strangler Fig).',
        stack: 'Spring Boot · Kotlin · AWS ECS',
        resultado: '70K+ usuarios, 0 min de downtime y 5x velocidad de deploys (claims del sitio).',
        tags: ['Spring Boot', 'Kotlin', 'AWS ECS'],
    },
];
---
<BaseLayout
    title="Casos de estudio | Arturo L. Gómez"
    description="Casos de Arturo L. Gómez: MailMind, CodeConductor, ATS StarTalent y migración a microservicios — reto, rol, stack e impacto."
    canonical="https://lgzarturo.com/casos-de-estudio/"
    keywords="casos de estudio, Arturo L. Gómez, MailMind, CodeConductor, ATS StarTalent, Programa de Lealtad, arquitectura de software"
    ogType="website"
>
    <script slot="head" type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://lgzarturo.com/" },
                    { "@type": "ListItem", "position": 2, "name": "Casos de estudio", "item": "https://lgzarturo.com/casos-de-estudio/" }
                ]
            },
            {
                "@type": "CollectionPage",
                "name": "Casos de estudio de Arturo L. Gómez",
                "description": "Productos indie y proyectos empresariales documentados por Arturo L. Gómez: MailMind, CodeConductor, ATS StarTalent y Programa de Lealtad.",
                "url": "https://lgzarturo.com/casos-de-estudio/",
                "inLanguage": "es",
                "author": { "@id": "https://lgzarturo.com/#person" }
            }
        ]
    }
    </script>
    <Header title="Arturo L. Gómez" />
    <main id="main" class="max-w-4xl mx-auto px-6 py-24">

        <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2" aria-label="Miga de pan">
            <a href="/" class="inline-block py-1 hover:text-blue-600 transition-colors">Inicio</a>
            <span>/</span>
            <span class="text-gray-800 font-medium dark:text-gray-100">Casos de estudio</span>
        </nav>

        <div class="mb-12">
            <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 leading-tight">
                Casos de estudio
            </h1>
            <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
                Productos que construyo y mantengo, y proyectos empresariales donde lideré el rediseño técnico.
                Cada tarjeta resume el problema, mi rol, el stack y el resultado —sin métricas inventadas.
            </p>
        </div>

        <div class="grid gap-8">
            {cases.map((c) => (
                <article class="border border-gray-200 dark:border-gray-800 rounded-2xl p-6 md:p-8 bg-gray-50 dark:bg-gray-900">
                    <span class={`inline-block px-2.5 py-0.5 mb-3 rounded-full text-xs font-medium border ${c.badgeClass}`}>{c.badge}</span>
                    <h2 class="text-xl md:text-2xl font-bold text-gray-900 dark:text-white mb-4">
                        <a href={c.href} class="hover:text-blue-700 dark:hover:text-blue-400 transition-colors">{c.title}</a>
                    </h2>
                    <dl class="space-y-3 text-sm md:text-base text-gray-700 dark:text-gray-300">
                        <div>
                            <dt class="font-semibold text-gray-900 dark:text-white">Problema</dt>
                            <dd class="mt-0.5 leading-relaxed">{c.problema}</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900 dark:text-white">Rol</dt>
                            <dd class="mt-0.5 leading-relaxed">{c.rol}</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900 dark:text-white">Stack</dt>
                            <dd class="mt-0.5 leading-relaxed">{c.stack}</dd>
                        </div>
                        <div>
                            <dt class="font-semibold text-gray-900 dark:text-white">Resultado</dt>
                            <dd class="mt-0.5 leading-relaxed">{c.resultado}</dd>
                        </div>
                    </dl>
                    <div class="flex flex-wrap gap-2 mt-4 mb-4">
                        {c.tags.map((tag) => (
                            <span class="px-2.5 py-0.5 bg-white dark:bg-gray-800 text-gray-600 dark:text-gray-300 border border-gray-200 dark:border-gray-700 rounded-full text-xs font-medium">{tag}</span>
                        ))}
                    </div>
                    <a href={c.href} class="inline-flex items-center gap-1 text-sm font-medium text-blue-600 hover:underline dark:text-blue-400">
                        Ver caso completo <span aria-hidden="true">→</span>
                    </a>
                </article>
            ))}
        </div>

        <div class="mt-12">
            <a href="/" class="inline-block py-1 text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors text-sm">← Volver al inicio</a>
        </div>
    </main>
    <Footer showQuote />
</BaseLayout>
