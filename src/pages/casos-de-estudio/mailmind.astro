---
// src/pages/casos-de-estudio/mailmind.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
    title="MailMind: centro de mando para el trabajo que nace en el correo | Arturo LG"
    description="Caso indie de Arturo LG: MailMind (v0.12.3) une IMAP, notas cifradas y proyectos; triaje y write-back a Jira/Sentry sin ser otro Gmail ni CRM."
    canonical="https://lgzarturo.com/casos-de-estudio/mailmind/"
    keywords="MailMind, IMAP IDLE, notas cifradas, kanban, write-back Jira Sentry, Arturo LG, producto indie"
    ogType="article"
>
    <script slot="head" type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://lgzarturo.com/" },
                    { "@type": "ListItem", "position": 2, "name": "Casos de estudio", "item": "https://lgzarturo.com/casos-de-estudio/" },
                    { "@type": "ListItem", "position": 3, "name": "MailMind" }
                ]
            },
            {
                "@type": "TechArticle",
                "headline": "MailMind: convertir la señal del correo en trabajo ejecutable",
                "description": "Caso de producto indie: cómo Arturo LG construyó MailMind, un centro de mando que une IMAP, notas y proyectos sin ser otro inbox ni CRM.",
                "datePublished": "2026-09-28",
                "dateModified": "2026-09-28",
                "inLanguage": "es",
                "author": { "@type": "Person", "name": "Arturo L. Gómez", "url": "https://lgzarturo.com/", "alternateName": "Arturo LG" },
                "publisher": { "@type": "Person", "name": "Arturo L. Gómez" },
                "mainEntityOfPage": "https://lgzarturo.com/casos-de-estudio/mailmind/",
                "about": ["MailMind", "productividad", "IMAP", "triage", "product engineering"],
                "keywords": "MailMind, IMAP IDLE, notas cifradas, kanban, write-back Jira Sentry, Arturo LG"
            },
            {
                "@type": "SoftwareApplication",
                "name": "MailMind",
                "url": "https://mailmindworks.com/",
                "applicationCategory": "BusinessApplication",
                "operatingSystem": "Web",
                "softwareVersion": "0.12.3",
                "isAccessibleForFree": true,
                "author": { "@type": "Person", "name": "Arturo L. Gómez", "url": "https://lgzarturo.com/" },
                "description": "Centro de mando que unifica bandeja IMAP, notas cifradas y proyectos: triaje, reglas e incidentes, con write-back a Jira/Sentry (no crea tickets).",
                "email": "hello@mailmindworks.com",
                "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD", "description": "Free beta" },
                "featureList": [
                    "Bandeja unificada IMAP (IDLE)",
                    "Notas cifradas estilo Keep + vault",
                    "Proyectos, kanban y Gantt",
                    "Reglas, VIP e incidentes",
                    "Write-back IMAP, Jira y Sentry (no crea tickets)",
                    "Webhooks Sentry/GitHub/Jira con HMAC",
                    "LLM triage opcional (apagado por defecto)",
                    "Mobile first"
                ]
            }
        ]
    }
    </script>
    <Header title="Arturo L. Gómez" />
    <main class="max-w-4xl mx-auto px-6 py-24">

        <!-- Breadcrumb -->
        <nav class="mb-8 text-sm text-gray-500 flex items-center gap-2">
            <a href="/" class="hover:text-blue-600 transition-colors">Inicio</a>
            <span>/</span>
            <a href="/casos-de-estudio/" class="hover:text-blue-600 transition-colors">Casos de estudio</a>
            <span>/</span>
            <span class="text-gray-800 font-medium">MailMind</span>
        </nav>

        <!-- Header -->
        <div class="mb-12">
            <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-rose-100 text-rose-800 rounded-full text-sm font-medium">MailMind · mailmindworks.com</span>
                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium">Producto indie</span>
                <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium">Beta gratuita en producción</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4 leading-tight">
                MailMind: convertir la señal del correo en trabajo ejecutable
            </h1>
            <p class="text-xl text-gray-600 leading-relaxed">
                Cómo construí un centro de mando —no otro cliente de correo— para que el trabajo que nace en la bandeja se vuelva tareas, notas y proyectos ejecutables, con límites claros frente a Gmail, CRM y chat.
            </p>
        </div>

        <!-- Métricas de impacto -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 p-8 bg-gradient-to-br from-rose-500 to-purple-700 rounded-2xl text-white text-center">
            <div>
                <span class="block text-3xl font-extrabold">v0.12.3</span>
                <span class="text-rose-100 text-sm mt-1 block">En producción</span>
            </div>
            <div>
                <span class="block text-3xl font-extrabold">Beta</span>
                <span class="text-rose-100 text-sm mt-1 block">Gratuita</span>
            </div>
            <div>
                <span class="block text-3xl font-extrabold">0</span>
                <span class="text-rose-100 text-sm mt-1 block">Tickets creados por write-back</span>
            </div>
            <div>
                <span class="block text-3xl font-extrabold">OFF</span>
                <span class="text-rose-100 text-sm mt-1 block">LLM triage por defecto</span>
            </div>
        </div>

        <!-- 01 El Reto -->
        <section class="mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <span class="text-red-600 font-bold text-sm">01</span>
                </div>
                <h2 class="text-2xl font-bold text-gray-900">El Reto</h2>
            </div>
            <div class="space-y-4 text-gray-700 leading-relaxed">
                <p>El correo sigue siendo el origen de demasiado trabajo real. El problema no era "leer más rápido": era que <strong>la señal se perdía entre ruido</strong>, y lo ejecutable vivía en tres sitios —bandeja, bloc de notas y un tablero a medias.</p>
                <ul class="space-y-3 ml-4">
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0">→</span>
                        <span><strong>Varias bandejas, cero visión:</strong> cuentas personales y de clientes sin un solo centro.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0">→</span>
                        <span><strong>Señal vs ruido:</strong> VIP, incidentes y spam sin reglas ni triaje accionable.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0">→</span>
                        <span><strong>Notas y tareas dispersas:</strong> lo que salía del correo no tenía destino natural (nota → tarea → proyecto).</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0">→</span>
                        <span><strong>La tentación del "todo en uno":</strong> reemplazar Gmail, auto-responder con IA o volverse CRM hincha el producto y rompe la confianza.</span>
                    </li>
                </ul>
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-6">
                    <p class="text-amber-800 font-medium text-sm">Definí qué <strong>no</strong> sería MailMind: no reemplaza Gmail/Outlook; no redacta ni responde correo; no es CRM; no es Slack. El objetivo era un centro de mando donde multi-inbox se convierte en tareas, proyectos y notas, con write-back cuidadoso a herramientas de ingeniería, y mobile first —porque el triaje no espera al escritorio.</p>
                </div>
            </div>
        </section>

        <!-- 02 La Arquitectura -->
        <section class="mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <span class="text-blue-600 font-bold text-sm">02</span>
                </div>
                <h2 class="text-2xl font-bold text-gray-900">La Arquitectura y Decisiones Técnicas</h2>
            </div>

            <p class="text-gray-700 leading-relaxed mb-8">
                Opté por construir MailMind como producto propio en <a href="https://mailmindworks.com/" target="_blank" rel="noopener" class="text-blue-600 hover:underline">mailmindworks.com</a>: núcleo de <strong>IMAP IDLE</strong> casi en tiempo real, notas cifradas estilo Keep + vault, promoción nota→tarea y proyectos (kanban / Gantt). La disciplina de producto fue tan crítica como la técnica: cada integración tiene un límite explícito.
            </p>

            <!-- Diagrama: Antes -->
            <div class="mb-8">
                <h3 class="text-base font-semibold text-gray-600 mb-3 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-red-400 flex-shrink-0"></span>
                    Antes — Trabajo atrapado en el correo
                </h3>
                <div class="bg-gray-950 rounded-2xl p-6 font-mono text-sm overflow-x-auto">
                    <div class="flex flex-col items-center gap-3 min-w-max mx-auto">
                        <div class="bg-red-950 border border-red-700 rounded-xl px-6 py-4 text-center">
                            <div class="text-red-300 font-bold text-sm mb-2">Inbox A · Inbox B · Inbox C → caos</div>
                            <div class="text-red-500 text-xs">Notas sueltas · Tareas mentales · "Lo veo después"</div>
                        </div>
                        <div class="text-gray-600 text-xs italic mt-2">Jira / Sentry / Telegram desconectados del origen</div>
                    </div>
                </div>
            </div>

            <!-- Diagrama: Después -->
            <div class="mb-8">
                <h3 class="text-base font-semibold text-gray-600 mb-3 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-green-400 flex-shrink-0"></span>
                    Después — Centro de mando MailMind
                </h3>
                <div class="bg-gray-950 rounded-2xl p-6 font-mono text-sm overflow-x-auto">
                    <div class="flex flex-col items-center gap-3 min-w-max mx-auto">
                        <div class="bg-gray-700 text-gray-200 px-5 py-2 rounded-lg text-center text-xs">Cuentas IMAP (+ OAuth Google solo cuenta, sin scopes Gmail)</div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-green-950 border border-green-700 rounded-xl px-8 py-4 text-center">
                            <div class="text-green-300 font-bold text-sm mb-2">IDLE near real-time</div>
                            <div class="flex flex-wrap justify-center gap-2 text-xs text-green-500">
                                <span class="bg-green-900/50 border border-green-800 px-2 py-1 rounded">Bandeja unificada</span>
                                <span class="bg-green-900/50 border border-green-800 px-2 py-1 rounded">Reglas</span>
                                <span class="bg-green-900/50 border border-green-800 px-2 py-1 rounded">VIP</span>
                                <span class="bg-green-900/50 border border-green-800 px-2 py-1 rounded">Incidentes</span>
                                <span class="bg-green-900/50 border border-green-800 px-2 py-1 rounded">LLM OFF por defecto</span>
                            </div>
                        </div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-gray-800 text-gray-300 px-4 py-2 rounded text-xs text-center">Notas cifradas / vault → promover a tarea → Proyectos (kanban / Gantt)</div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-gray-800 text-gray-300 px-4 py-2 rounded text-xs text-center">Write-back IMAP · Jira · Sentry &nbsp;|&nbsp; Webhooks HMAC Sentry · GitHub · Jira</div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-gray-800 text-gray-300 px-4 py-2 rounded text-xs text-center">Digests Telegram · Jev (categorización masiva en 0.12.3)</div>
                    </div>
                </div>
            </div>

            <!-- Decisiones técnicas -->
            <div class="space-y-6">
                <div class="bg-green-50 border-l-4 border-green-500 rounded-r-xl p-5">
                    <h4 class="font-bold text-gray-900 mb-2">¿Por qué IMAP IDLE (y no otra Gmail API app)?</h4>
                    <p class="text-gray-700 text-sm leading-relaxed">Quería multi-proveedor de verdad. IDLE da near real-time sin amarrar el producto a un vendor. El OAuth de Google es <strong>solo cuenta</strong>, sin permisos de Gmail: una decisión de confianza deliberada.</p>
                </div>
                <div class="bg-blue-50 border-l-4 border-blue-500 rounded-r-xl p-5">
                    <h4 class="font-bold text-gray-900 mb-2">Write-back con límites</h4>
                    <p class="text-gray-700 text-sm leading-relaxed">MailMind puede marcar leído, archivar o eliminar en IMAP y, al cerrar trabajo, transicionar Jira o resolver Sentry. Lo que <strong>no</strong> hace: crear tickets. Ese "no" evita generar ruido en los sistemas de ingeniería. Los webhooks nativos van firmados con HMAC.</p>
                </div>
                <div class="bg-purple-50 border-l-4 border-purple-500 rounded-r-xl p-5">
                    <h4 class="font-bold text-gray-900 mb-2">Notas cifradas → ejecución</h4>
                    <p class="text-gray-700 text-sm leading-relaxed">Las notas + vault no son un bloc ornamental: capturan contexto sensible y se <strong>promueven</strong> a tarea cuando la señal está clara. De ahí a kanban/Gantt sin cambiar de herramienta mental.</p>
                </div>
                <div class="bg-orange-50 border-l-4 border-orange-500 rounded-r-xl p-5">
                    <h4 class="font-bold text-gray-900 mb-2">LLM apagado por defecto</h4>
                    <p class="text-gray-700 text-sm leading-relaxed">Hay triaje opcional con LLM, pero <strong>off by default</strong>. Primero reglas, VIP e incidentes. En v0.12.3 sumé categorización masiva con Jev para ordenar la bandeja sin obligar a un modelo en el camino crítico.</p>
                </div>
            </div>

            <p class="text-gray-700 leading-relaxed mt-8">
                Personas: freelancers/consultores, profesionales saturados y equipos pequeños. Si el triaje no cabe en el teléfono, no es triaje: es otra deuda. Por eso MailMind es <strong>mobile first</strong>.
            </p>
        </section>

        <!-- 03 El Impacto -->
        <section class="mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0">
                    <span class="text-green-600 font-bold text-sm">03</span>
                </div>
                <h2 class="text-2xl font-bold text-gray-900">El Impacto</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-6 mb-8">
                <div class="bg-rose-50 border border-rose-200 rounded-2xl p-6">
                    <div class="text-3xl font-extrabold text-rose-700 mb-2">v0.6.3 → v0.12.3</div>
                    <div class="font-semibold text-gray-900 mb-2">En producción, con camino a 1.0.0</div>
                    <p class="text-gray-600 text-sm leading-relaxed">No es un mockup: beta gratuita con camino explícito a la 1.0.0. Cada release endurece bandeja, notas, proyectos, triaje, write-back y UX mobile.</p>
                </div>
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6">
                    <div class="text-3xl font-extrabold text-blue-700 mb-2">Señal → trabajo</div>
                    <div class="font-semibold text-gray-900 mb-2">Sin otro inbox</div>
                    <p class="text-gray-600 text-sm leading-relaxed">Bandeja unificada + reglas/VIP/incidentes convierte el correo en algo accionable sin pedir abandonar Gmail u Outlook.</p>
                </div>
                <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6">
                    <div class="text-3xl font-extrabold text-purple-700 mb-2">Integraciones</div>
                    <div class="font-semibold text-gray-900 mb-2">Que respetan el flujo</div>
                    <p class="text-gray-600 text-sm leading-relaxed">Write-back sin crear tickets, webhooks HMAC y digests a Telegram: el producto se enchufa al sistema existente en lugar de sustituirlo.</p>
                </div>
                <div class="bg-teal-50 border border-teal-200 rounded-2xl p-6">
                    <div class="text-3xl font-extrabold text-teal-700 mb-2">Privacidad</div>
                    <div class="font-semibold text-gray-900 mb-2">Como default</div>
                    <p class="text-gray-600 text-sm leading-relaxed">Notas cifradas, OAuth sin scopes de Gmail, LLM opcional apagado. La confianza es una serie de "no" conscientes, no un banner.</p>
                </div>
            </div>
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-6">
                <h3 class="font-bold text-gray-900 mb-2">Lección clave</h3>
                <p class="text-gray-600 text-sm leading-relaxed">El aprendizaje más duro de un producto indie no es qué features añadir: es qué rechazar. MailMind funciona porque se niega a ser cliente de correo, autoresponder o CRM. El valor está en el puente —de señal a nota, a tarea, a proyecto— y en write-backs que no ensucian los sistemas vecinos. Construir menos, con límites claros, es lo que hace que un centro de mando se sienta ligero.</p>
            </div>
        </section>

        <!-- Stack -->
        <section class="mb-16">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Stack Utilizado</h2>
            <div class="flex flex-wrap gap-3">
                <span class="px-4 py-2 bg-python-100 text-python-800 rounded-full text-sm font-medium">Python</span>
                <span class="px-4 py-2 bg-seo-100 text-seo-800 rounded-full text-sm font-medium">FastAPI</span>
                <span class="px-4 py-2 bg-cyan-100 text-cyan-800 rounded-full text-sm font-medium">HTMX</span>
                <span class="px-4 py-2 bg-devops-100 text-devops-800 rounded-full text-sm font-medium">IMAP IDLE</span>
                <span class="px-4 py-2 bg-js-100 text-js-800 rounded-full text-sm font-medium">OAuth (solo cuenta)</span>
                <span class="px-4 py-2 bg-micro-100 text-micro-800 rounded-full text-sm font-medium">Webhooks HMAC</span>
            </div>
        </section>

        <!-- CTA -->
        <div class="bg-gradient-to-r from-rose-500 to-purple-700 rounded-2xl p-8 text-center text-white">
            <h3 class="text-2xl font-bold mb-2">¿Tu trabajo también nace en el correo y muere en pestañas?</h3>
            <p class="text-rose-100 mb-6">Prueba MailMind en beta o cuéntame cómo estás resolviendo el triaje hoy.</p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="https://mailmindworks.com/" target="_blank" rel="noopener" class="inline-block bg-white text-rose-700 font-semibold px-8 py-3 rounded-xl hover:bg-rose-50 transition-colors">
                    Probar MailMind
                </a>
                <a href="mailto:hello@mailmindworks.com" class="inline-block bg-white/15 border border-white/40 text-white font-semibold px-8 py-3 rounded-xl hover:bg-white/25 transition-colors">
                    Escribir a hello@mailmindworks.com
                </a>
            </div>
        </div>

        <!-- Otros casos de estudio -->
        <section class="mt-16 pt-8 border-t border-gray-200">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 mb-4">Otros casos de estudio</h2>
            <div class="grid gap-4 md:grid-cols-1">
                <a href="/casos-de-estudio/codeconductor/" class="group block bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl p-6 transition-colors">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-700 transition-colors">CodeConductor</h3>
                            <p class="text-gray-600 text-sm mt-1">De prompts sueltos a orquestación multi-agente (npm cc-codeconductor 1.5.0).</p>
                        </div>
                        <span class="text-blue-600 text-2xl flex-shrink-0 group-hover:translate-x-1 transition-transform">→</span>
                    </div>
                </a>
                <a href="/casos-de-estudio/ats-startalent/" class="group block bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl p-6 transition-colors">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-700 transition-colors">ATS StarTalent a SaaS</h3>
                            <p class="text-gray-600 text-sm mt-1">De herramienta interna a producto multi-tenant.</p>
                        </div>
                        <span class="text-blue-600 text-2xl flex-shrink-0 group-hover:translate-x-1 transition-transform">→</span>
                    </div>
                </a>
                <a href="/casos-de-estudio/programa-de-lealtad/" class="group block bg-gray-50 hover:bg-gray-100 border border-gray-200 rounded-2xl p-6 transition-colors">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 group-hover:text-blue-700 transition-colors">Programa de Lealtad a microservicios</h3>
                            <p class="text-gray-600 text-sm mt-1">Strangler Fig, 70K+ usuarios, 0 min downtime.</p>
                        </div>
                        <span class="text-blue-600 text-2xl flex-shrink-0 group-hover:translate-x-1 transition-transform">→</span>
                    </div>
                </a>
            </div>
            <div class="mt-6 flex gap-4">
                <a href="/casos-de-estudio/" class="text-gray-500 hover:text-blue-600 transition-colors text-sm">← Hub de casos</a>
                <a href="/" class="text-gray-500 hover:text-blue-600 transition-colors text-sm">Inicio</a>
            </div>
        </section>
    </main>
    <Footer />
</BaseLayout>
