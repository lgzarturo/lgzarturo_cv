---
// src/pages/casos-de-estudio/codeconductor.astro
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
---
<BaseLayout
    title="CodeConductor: orquestación open source para ingeniería asistida por IA | Arturo LG"
    description="Cómo convertí el prompting caótico en un sistema de ingeniería reproducible: CodeConductor (npm cc-codeconductor 1.5.0), framework MIT multi-agente."
    canonical="https://lgzarturo.com/casos-de-estudio/codeconductor/"
    keywords="CodeConductor, cc-codeconductor, agentes IA, Claude Code, Codex, Cursor, open source, TypeScript, Arturo LG"
    ogType="article"
>
    <script slot="head" type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@graph": [
            {
                "@type": "BreadcrumbList",
                "itemListElement": [
                    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://lgzarturo.com/" },
                    { "@type": "ListItem", "position": 2, "name": "Casos de estudio", "item": "https://lgzarturo.com/casos-de-estudio/" },
                    { "@type": "ListItem", "position": 3, "name": "CodeConductor" }
                ]
            },
            {
                "@type": "TechArticle",
                "headline": "CodeConductor: de prompts sueltos a un sistema de ingeniería orquestado",
                "description": "Caso de product-engineering: cómo Arturo LG construyó un framework open source de orquestación multi-agente para flujos de coding asistidos por IA.",
                "datePublished": "2026-09-28",
                "dateModified": "2026-09-28",
                "inLanguage": "es",
                "author": { "@type": "Person", "name": "Arturo L. Gómez", "url": "https://lgzarturo.com/", "alternateName": "Arturo LG" },
                "publisher": { "@type": "Person", "name": "Arturo L. Gómez" },
                "mainEntityOfPage": "https://lgzarturo.com/casos-de-estudio/codeconductor/",
                "about": ["CodeConductor", "AI agents", "orquestación multi-agente", "ingeniería asistida por IA", "open source"],
                "keywords": "CodeConductor, cc-codeconductor, agentes IA, Claude Code, Codex, Cursor, open source, TypeScript"
            },
            {
                "@type": "SoftwareApplication",
                "name": "CodeConductor",
                "alternateName": "cc-codeconductor",
                "applicationCategory": "DeveloperApplication",
                "operatingSystem": "Cross-platform (CLI / IDE targets)",
                "softwareVersion": "1.5.0",
                "license": "https://opensource.org/licenses/MIT",
                "url": "https://github.com/lgzarturo/codeconductor",
                "downloadUrl": "https://www.npmjs.com/package/cc-codeconductor",
                "author": { "@type": "Person", "name": "Arturo L. Gómez", "url": "https://lgzarturo.com/" },
                "description": "Framework open source de ingeniería asistida por IA: convierte prompting caótico en un sistema de orquestación multi-agente reproducible.",
                "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
            }
        ]
    }
    </script>
    <Header title="Arturo L. Gómez" />
    <main id="main" class="max-w-4xl mx-auto px-6 py-24">

        <!-- Breadcrumb -->
        <nav class="mb-8 text-sm text-gray-500 dark:text-gray-400 flex items-center gap-2">
            <a href="/" class="inline-block py-1 hover:text-blue-600 transition-colors">Inicio</a>
            <span>/</span>
            <a href="/casos-de-estudio/" class="inline-block py-1 hover:text-blue-600 transition-colors">Casos de estudio</a>
            <span>/</span>
            <span class="text-gray-800 font-medium dark:text-gray-100">CodeConductor</span>
        </nav>

        <!-- Header -->
        <div class="mb-12">
            <div class="flex flex-wrap gap-2 mb-4">
                <span class="px-3 py-1 bg-slate-100 text-slate-800 rounded-full text-sm font-medium dark:bg-slate-900/40 dark:text-slate-300">2026 – presente</span>
                <span class="px-3 py-1 bg-purple-100 text-purple-800 rounded-full text-sm font-medium dark:bg-purple-900/40 dark:text-purple-300">Open source / Product engineering</span>
                <span class="px-3 py-1 bg-green-100 text-green-800 rounded-full text-sm font-medium dark:bg-green-900/40 dark:text-green-300">MIT · npm 1.5.0</span>
            </div>
            <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 dark:text-white mb-4 leading-tight">
                CodeConductor: de prompts sueltos a un sistema de ingeniería orquestado
            </h1>
            <p class="text-xl text-gray-600 dark:text-gray-300 leading-relaxed">
                Cómo convertí el prompting ad-hoc en un framework open source de orquestación multi-agente —para que planificar, implementar, probar y revisar dejen de depender del "chat de la suerte" y se vuelvan un flujo reproducible.
            </p>
        </div>

        <!-- Métricas de impacto -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16 p-8 bg-gradient-to-br from-slate-700 to-purple-800 rounded-2xl text-white text-center">
            <div>
                <span class="block text-3xl font-extrabold">1.5.0</span>
                <span class="text-slate-200 text-sm mt-1 block">Versión estable npm</span>
            </div>
            <div>
                <span class="block text-3xl font-extrabold">MIT</span>
                <span class="text-slate-200 text-sm mt-1 block">Licencia · TypeScript</span>
            </div>
            <div>
                <span class="block text-3xl font-extrabold">15</span>
                <span class="text-slate-200 text-sm mt-1 block">Conductor Agents</span>
            </div>
            <div>
                <span class="block text-3xl font-extrabold">21+</span>
                <span class="text-slate-200 text-sm mt-1 block">Slash commands</span>
            </div>
        </div>
        <p class="text-gray-500 dark:text-gray-400 text-sm -mt-10 mb-16 text-center">Targets de instalación: opencode · claude · codex · agy · cursor · gemini</p>

        <!-- 01 El Reto -->
        <section class="mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 bg-red-100 rounded-lg flex items-center justify-center flex-shrink-0 dark:bg-red-900/40">
                    <span class="text-red-700 font-bold text-sm dark:text-red-400">01</span>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">El Reto</h2>
            </div>
            <div class="space-y-4 text-gray-700 dark:text-gray-300 leading-relaxed">
                <p>En 2026 el tooling de coding con IA ya no era el cuello de botella: lo era <strong>la falta de sistema</strong>. Una sesión brillante; la siguiente, el mismo modelo inventaba arquitectura, saltaba pruebas o "arreglaba" lo que nadie pidió. Lo vi en mi práctica y en equipos con Claude Code, Codex, Cursor u OpenCode.</p>
                <ul class="space-y-3 ml-4">
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0 dark:text-red-400">→</span>
                        <span><strong>Prompts sin contrato:</strong> la intención vivía en la cabeza de quien chateaba. Sin task card, sin criterios de aceptación, sin rastro versionado.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0 dark:text-red-400">→</span>
                        <span><strong>El modelo como "el desarrollador":</strong> diseñar, implementar, probar y auto-aprobar en un solo rol —sin veto ni quorum.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0 dark:text-red-400">→</span>
                        <span><strong>Flujos no portables:</strong> lo que funcionaba en un IDE no se instalaba limpio en otro; skills y comandos eran artesanales.</span>
                    </li>
                    <li class="flex gap-3">
                        <span class="text-red-500 font-bold mt-0.5 flex-shrink-0 dark:text-red-400">→</span>
                        <span><strong>Riesgo sin routing:</strong> un cambio cosmético y uno de seguridad entraban por el mismo tubo.</span>
                    </li>
                </ul>
                <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mt-6 dark:bg-amber-950/40 dark:border-amber-800">
                    <p class="text-amber-800 font-medium text-sm dark:text-amber-300">El objetivo: dejar de prompting y empezar a orquestar. Un framework —no un wrapper de un solo vendor— que trate a los modelos como trabajadores especializados, con contratos, loops y control humano. <em>Stop prompting. Start orchestrating.</em></p>
                </div>
            </div>
        </section>

        <!-- 02 La Arquitectura -->
        <section class="mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 bg-blue-100 rounded-lg flex items-center justify-center flex-shrink-0 dark:bg-blue-900/40">
                    <span class="text-blue-700 font-bold text-sm dark:text-blue-400">02</span>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">La Arquitectura y Decisiones Técnicas</h2>
            </div>

            <p class="text-gray-700 dark:text-gray-300 leading-relaxed mb-8">
                Opté por un CLI/framework en <strong>TypeScript</strong>, npm <code>cc-codeconductor</code>, con instalación multi-target y una filosofía explícita: <strong>modelos como workers</strong>, no como reemplazo del desarrollador. Encima: contratos de agente versionados, task cards y routing por riesgo.
            </p>

            <!-- Diagrama: Antes -->
            <div class="mb-8">
                <h3 class="text-base font-semibold text-gray-600 dark:text-gray-300 mb-3 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-red-400 flex-shrink-0"></span>
                    Antes — Prompting caótico
                </h3>
                <div class="bg-gray-950 rounded-2xl p-6 font-mono text-sm overflow-x-auto">
                    <div class="flex flex-col items-center gap-3 min-w-max mx-auto">
                        <div class="bg-red-950 border border-red-700 rounded-xl px-6 py-4 text-center">
                            <div class="text-red-300 font-bold text-sm mb-2">Humano → Chat libre → Modelo "hace de todo"</div>
                            <div class="text-red-400 text-xs">Sin roles · Sin task card · Sin consenso · Sin portabilidad</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Diagrama: Después -->
            <div class="mb-8">
                <h3 class="text-base font-semibold text-gray-600 dark:text-gray-300 mb-3 flex items-center gap-2">
                    <span class="w-3 h-3 rounded-full bg-green-400 flex-shrink-0"></span>
                    Después — Orquestación CodeConductor
                </h3>
                <div class="bg-gray-950 rounded-2xl p-6 font-mono text-sm overflow-x-auto">
                    <div class="flex flex-col items-center gap-3 min-w-max mx-auto">
                        <div class="bg-gray-700 text-gray-200 px-5 py-2 rounded-lg text-center text-xs">Humano + Task Card</div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-gray-800 text-gray-300 px-4 py-2 rounded text-xs text-center">Setup (opencode | claude | codex | agy | cursor | gemini)</div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-green-950 border border-green-700 rounded-xl px-8 py-4 text-center">
                            <div class="text-green-300 font-bold text-sm mb-2">Conductor Agents (15+) ↔ Council (quorum/veto)</div>
                            <div class="text-green-500 text-xs dark:text-green-400">CCEP: parse → profile → resolve → compile → validate → evaluate → consensus → taskcard</div>
                        </div>
                        <div class="w-px h-5 bg-gray-600"></div>
                        <div class="bg-gray-800 text-gray-300 px-4 py-2 rounded text-xs text-center">OpenSpec delivery · Scorecard · Product OS · 21+ slash commands</div>
                    </div>
                </div>
            </div>

            <!-- Decisiones técnicas -->
            <div class="space-y-6">
                <div class="bg-blue-50 border-l-4 border-blue-500 rounded-r-xl p-5 dark:bg-blue-950/40">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-2">¿Por qué un framework y no otro prompt pack?</h4>
                    <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">Un pack se pudre en una semana. Necesitaba install, migrate, doctor/status/version/update y presets por target. CodeConductor detecta el entorno y deja skills/comandos coherentes —no un gist copiado a mano.</p>
                </div>
                <div class="bg-purple-50 border-l-4 border-purple-500 rounded-r-xl p-5 dark:bg-purple-950/40">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-2">Workers especializados + council</h4>
                    <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">Diseñé 15 Conductor Agents con roles acotados (reviewer, security-reviewer, complexity-auditor, entre otros). El de seguridad no implementa features; el implementador no se auto-aprueba. El council aplica quorum y veto cuando el riesgo lo exige.</p>
                </div>
                <div class="bg-green-50 border-l-4 border-green-500 rounded-r-xl p-5 dark:bg-green-950/40">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-2">Loop CCEP + OpenSpec</h4>
                    <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">En lugar de "hazlo todo", el flujo se descompone hasta materializar la task card. OpenSpec y el scorecard cierran con evidencia, no con "parece que quedó bien".</p>
                </div>
                <div class="bg-orange-50 border-l-4 border-orange-500 rounded-r-xl p-5 dark:bg-orange-950/40">
                    <h4 class="font-bold text-gray-900 dark:text-white mb-2">Skills de stack y multi-target</h4>
                    <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed">Skills por ecosistema (ts-next-drizzle, spring-kotlin-jpa, laravel-tall, python-data-api) para hablar el idioma del repo. Mismo sistema si el equipo vive en Cursor o en Claude Code.</p>
                </div>
            </div>

            <p class="text-gray-700 dark:text-gray-300 leading-relaxed mt-8">
                Lo que aún no es (a propósito): sin runtime sandbox, policy compiler ni pruning completo de assets. Preferí un <strong>1.5.x estable</strong> a un roadmap inflado: esas piezas quedan como trabajo futuro explícito.
            </p>
        </section>

        <!-- 03 El Impacto -->
        <section class="mb-16">
            <div class="flex items-center gap-3 mb-6">
                <div class="w-8 h-8 bg-green-100 rounded-lg flex items-center justify-center flex-shrink-0 dark:bg-green-900/40">
                    <span class="text-green-800 font-bold text-sm dark:text-green-400">03</span>
                </div>
                <h2 class="text-2xl font-bold text-gray-900 dark:text-white">El Impacto</h2>
            </div>
            <div class="grid md:grid-cols-2 gap-6 mb-8">
                <div class="bg-slate-50 border border-slate-200 rounded-2xl p-6 dark:bg-slate-950/40 dark:border-slate-800">
                    <div class="text-3xl font-extrabold text-slate-700 mb-2 dark:text-slate-300">Reproducible</div>
                    <div class="font-semibold text-gray-900 dark:text-white mb-2">Sistema, no memoria de chat</div>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">Contratos, task cards y roles: el loop planificar → implementar → probar → revisar se puede retomar, auditar y migrar.</p>
                </div>
                <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 dark:bg-blue-950/40 dark:border-blue-800">
                    <div class="text-3xl font-extrabold text-blue-700 mb-2 dark:text-blue-300">Multi-target</div>
                    <div class="font-semibold text-gray-900 dark:text-white mb-2">Un framework, seis IDEs</div>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">opencode, Claude, Codex, AGY, Cursor y Gemini. Baja el costo de cambiar de IDE sin forks mentales.</p>
                </div>
                <div class="bg-purple-50 border border-purple-200 rounded-2xl p-6 dark:bg-purple-950/40 dark:border-purple-800">
                    <div class="text-3xl font-extrabold text-purple-700 mb-2 dark:text-purple-300">Quorum y veto</div>
                    <div class="font-semibold text-gray-900 dark:text-white mb-2">Gobernanza donde importa</div>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">Fricción en seguridad y complejidad, velocidad donde no. Ingeniería, no autocompletado con superpoderes.</p>
                </div>
                <div class="bg-green-50 border border-green-200 rounded-2xl p-6 dark:bg-green-950/40 dark:border-green-800">
                    <div class="text-3xl font-extrabold text-green-700 mb-2 dark:text-green-300">MIT</div>
                    <div class="font-semibold text-gray-900 dark:text-white mb-2">Etapa temprana, repo público</div>
                    <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed"><a href="https://github.com/lgzarturo/codeconductor" target="_blank" rel="noopener" class="text-blue-600 hover:underline dark:text-blue-400">github.com/lgzarturo/codeconductor</a>, paquete en npm.</p>
                </div>
            </div>
            <div class="bg-gray-50 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 dark:bg-gray-900">
                <h3 class="font-bold text-gray-900 dark:text-white mb-2">Lección clave</h3>
                <p class="text-gray-600 dark:text-gray-300 text-sm leading-relaxed">El problema no es "mejorar el prompt": es diseñar un sistema donde la IA tiene contratos, límites y un lugar en el SDLC. Tratar al modelo como oráculo invita al caos; tratarlo como worker especializado —con task cards, consenso y veto— convierte la asistencia en ingeniería. CodeConductor es esa apuesta: en evolución, usable en 1.5.x.</p>
            </div>
        </section>

        <!-- Stack -->
        <section class="mb-16">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Stack Utilizado</h2>
            <div class="flex flex-wrap gap-3">
                <span class="px-4 py-2 bg-js-100 text-js-800 rounded-full text-sm font-medium">TypeScript</span>
                <span class="px-4 py-2 bg-seo-100 text-seo-800 rounded-full text-sm font-medium">npm (cc-codeconductor)</span>
                <span class="px-4 py-2 bg-devops-100 text-devops-800 rounded-full text-sm font-medium">Multi-agent orchestration</span>
                <span class="px-4 py-2 bg-micro-100 text-micro-800 rounded-full text-sm font-medium">CCEP / OpenSpec</span>
                <span class="px-4 py-2 bg-python-100 text-python-800 rounded-full text-sm font-medium">Stack skills (TS, Spring/Kotlin, Laravel, Python)</span>
            </div>
        </section>

        <!-- CTA -->
        <div class="bg-gradient-to-r from-slate-700 to-purple-800 rounded-2xl p-8 text-center text-white">
            <h3 class="text-2xl font-bold mb-2">¿Tu equipo está ahogado en prompts brillantes pero irreproducibles?</h3>
            <p class="text-slate-200 mb-6">Hablemos de orquestación, contratos de agente y cómo meter IA en el flujo real de entrega —sin magia y con gobernanza.</p>
            <div class="flex flex-wrap justify-center gap-4">
                <a href="mailto:lgzarturo@gmail.com" class="inline-block bg-white text-slate-800 font-semibold px-8 py-3 rounded-xl hover:bg-slate-50 transition-colors">
                    Escribirme
                </a>
                <a href="https://github.com/lgzarturo/codeconductor" target="_blank" rel="noopener" class="inline-block bg-white/15 border border-white/40 text-white font-semibold px-8 py-3 rounded-xl hover:bg-white/25 transition-colors">
                    Ver en GitHub
                </a>
                <a href="https://www.npmjs.com/package/cc-codeconductor" target="_blank" rel="noopener" class="inline-block bg-white/15 border border-white/40 text-white font-semibold px-8 py-3 rounded-xl hover:bg-white/25 transition-colors">
                    Ver en npm
                </a>
            </div>
        </div>

        <!-- Otros casos de estudio -->
        <section class="mt-16 pt-8 border-t border-gray-200 dark:border-gray-800">
            <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400 mb-4">Otros casos de estudio</h2>
            <div class="grid gap-4 md:grid-cols-1">
                <a href="/casos-de-estudio/mailmind/" class="group block bg-gray-50 hover:bg-gray-100 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 transition-colors dark:bg-gray-900">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-blue-700 transition-colors">MailMind</h3>
                            <p class="text-gray-600 dark:text-gray-300 text-sm mt-1">Producto indie: IMAP, notas y proyectos sin ser otro CRM.</p>
                        </div>
                        <span class="text-blue-600 text-2xl flex-shrink-0 group-hover:translate-x-1 transition-transform dark:text-blue-400">→</span>
                    </div>
                </a>
                <a href="/casos-de-estudio/ats-startalent/" class="group block bg-gray-50 hover:bg-gray-100 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 transition-colors dark:bg-gray-900">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-blue-700 transition-colors">Rediseño del ATS StarTalent a SaaS hotelero</h3>
                            <p class="text-gray-600 dark:text-gray-300 text-sm mt-1">De herramienta interna a producto multi-tenant.</p>
                        </div>
                        <span class="text-blue-600 text-2xl flex-shrink-0 group-hover:translate-x-1 transition-transform dark:text-blue-400">→</span>
                    </div>
                </a>
                <a href="/casos-de-estudio/programa-de-lealtad/" class="group block bg-gray-50 hover:bg-gray-100 border border-gray-200 dark:border-gray-800 rounded-2xl p-6 transition-colors dark:bg-gray-900">
                    <div class="flex items-center justify-between gap-4">
                        <div>
                            <h3 class="text-lg font-bold text-gray-900 dark:text-white group-hover:text-blue-700 transition-colors">Migración del Programa de Lealtad a microservicios</h3>
                            <p class="text-gray-600 dark:text-gray-300 text-sm mt-1">Strangler Fig, 70K+ usuarios, 0 min downtime.</p>
                        </div>
                        <span class="text-blue-600 text-2xl flex-shrink-0 group-hover:translate-x-1 transition-transform dark:text-blue-400">→</span>
                    </div>
                </a>
            </div>
            <div class="mt-6 flex gap-4">
                <a href="/casos-de-estudio/" class="inline-block py-1 text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors text-sm">← Hub de casos</a>
                <a href="/" class="inline-block py-1 text-gray-500 dark:text-gray-400 hover:text-blue-600 transition-colors text-sm">Inicio</a>
            </div>
        </section>
    </main>
    <Footer showQuote />
</BaseLayout>
